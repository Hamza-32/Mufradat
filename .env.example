# ---------------------------------------------------------------------------
# Database (Neon or Supabase free tier). Use the POOLED connection string when
# deploying to Vercel; the direct string is only needed for migrations.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host/mufradat?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/mufradat?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js v5. Generate a secret with:  npx auth secret
# ---------------------------------------------------------------------------
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# Upstash Redis (free tier) — rate limiting for mutating routes.
# Leave blank in local dev: the limiter falls back to an in-memory limiter.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Optional: audio CDN base (Cloudflare R2 free tier). Empty = serve from
# /public/audio in the repo.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_AUDIO_BASE_URL=""

# ---------------------------------------------------------------------------
# The address shown on /privacy and /terms for data questions and deletion
# requests. Google re-checks those pages to keep the consent screen valid, so
# this must be an address you actually read.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=""
